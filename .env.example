# Copy to .env and fill in. Never commit .env.

DJANGO_DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL in production). DB_ENGINE=sqlite is for development/tests only:
# it has no row-level locking, so it must never be used for real tills.
DB_ENGINE=postgres
DB_NAME=winespos
DB_USER=winespos
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Security policy
SESSION_IDLE_MINUTES=30
APPROVAL_TOKEN_MINUTES=2
POS_AUTH_MINUTES=5
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=5
MAX_TILLS=2
# Discounts up to this percent of a line need no approval (for staff allowed to give discounts)
ORDINARY_DISCOUNT_MAX_PERCENT=5
USE_ARGON2=false

# Optional fingerprint (Windows Hello) support. Off by default.
# The desktop shell asserts a successful OS biometric check using this shared secret.
BIOMETRIC_ENABLED=false
DESKTOP_SHELL_SECRET=

# Desktop shell
WINESPOS_SERVER_URL=http://127.0.0.1:8000

# Where uploaded product images are stored (default: <project>/media). Keep it inside the shop's backup.
# WINESPOS_MEDIA_ROOT=C:\ProgramData\WinesPOS\media

# --- KRA eTIMS (Kenya electronic tax invoices). Leave ETIMS_MODE=off until your accountant and KRA onboarding are done. ---
# off     = receipts show VAT (if the shop is VAT registered) but are NOT KRA tax invoices; nothing is sent.
# sandbox = send to KRA's test system. live = real invoices.
ETIMS_MODE=off
# vscu = KRA's small program installed on the shop PC (copes with short internet outages); oscu = KRA online.
ETIMS_INTEGRATION=vscu
ETIMS_BASE_URL=
ETIMS_BRANCH_ID=00
ETIMS_DEVICE_SERIAL=
# Only for OSCU. Secret: keep it in .env.
ETIMS_COMM_KEY=
ETIMS_TIMEOUT_SECONDS=8
# Where the receipt QR points; use {tin} {bhf} {sign}. Empty = no QR is printed (nothing is invented).
ETIMS_QR_URL_TEMPLATE=
