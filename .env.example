# =====================================================================================================
#  WINES POS - ONE COMBINED .env (copy to .env, fill in, never commit or share the real one)
# =====================================================================================================
#  Every variable below is read by the code. Tags tell you WHERE it can be changed:
#    [ENV ONLY]      only this file (needed before the database opens, or not a manager setting)
#    [ADMIN: Server settings]                Django admin > Server settings. A value saved there WINS over this file.
#    [ADMIN: Payment and tax integration]    Django admin. A switch picks "Environment file" or "Database".
#  Leave a line blank to use the built-in default shown in the comment.
# =====================================================================================================


# ---- 1. CORE (the system cannot start without these) ------------------------------------------------
# [ENV ONLY]
DJANGO_DEBUG=false
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"    (use a long random value, never a word)
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Only needed when the site is opened through an https address, e.g. https://pos.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Keeps secrets saved in the admin encrypted. Set once, keep it safe and NEVER change it afterwards.
INTEGRATION_SETTINGS_KEY=


# ---- 2. DATABASE [ENV ONLY] --------------------------------------------------------------------------
# postgres for real tills. sqlite is for development/tests only (no row locking).
DB_ENGINE=postgres
DB_NAME=winespos
DB_USER=winespos
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432


# ---- 3. SECURITY POLICY [ADMIN: Server settings > Security policy] ----------------------------------
SESSION_IDLE_MINUTES=30            # sign out after this many idle minutes
APPROVAL_TOKEN_MINUTES=2           # a supervisor approval stays valid this long
POS_AUTH_MINUTES=5                 # a till authorization stays valid this long
LOCKOUT_MAX_ATTEMPTS=5             # wrong passwords before a lock
LOCKOUT_MINUTES=5                  # how long the lock lasts
MAX_TILLS=2
ORDINARY_DISCOUNT_MAX_PERCENT=5    # discount a cashier may give with no approval
BIOMETRIC_ENABLED=false            # Windows Hello fingerprint sign-in
DESKTOP_SHELL_SECRET=              # secret: only if fingerprint is on
# [ENV ONLY]
USE_ARGON2=false


# ---- 4. DESKTOP / INSTALLED SHOP [ENV ONLY] ---------------------------------------------------------
WINESPOS_SERVER_URL=http://127.0.0.1:8000
# 127.0.0.1 = this PC only. 0.0.0.0 = the shop network too (needed for a second till; also add the address to ALLOWED_HOSTS).
WINESPOS_BIND=127.0.0.1
WINESPOS_PORT=8000
# Written by the installer. Keeps .env, backups and images outside the program folder.
# WINESPOS_DATA_DIR=C:\ProgramData\WinesPOS
# Point to a specific env file (the installer sets this itself).
# WINESPOS_ENV_FILE=C:\ProgramData\WinesPOS\config\winespos.env
# Product image folder (default: <project>/media). Keep it inside the shop's backup.
# WINESPOS_MEDIA_ROOT=C:\ProgramData\WinesPOS\media
# Receipt printer: exact Windows name (list with: WinesPOS.exe printers). Empty = normal Windows print dialog.
# WINESPOS_RECEIPT_PRINTER=EPSON TM-T20III Receipt
# First-time setup helpers (used only by the setup commands; remove after use):
# WINESPOS_MANAGER_PASSWORD=
# WINESPOS_PG_ADMIN_PASSWORD=


# ---- 5. BARCODE LOOKUP [ENV: providers; ADMIN or ENV: API key] ----------------------------------------
# Master switch for ALL online lookups. Your own product list is always checked first.
OPEN_FOOD_FACTS_ENABLED=false
# Providers tried in this order. Barcode Lookup uses an API plan and may incur charges.
EXTERNAL_LOOKUP_PROVIDERS=openfoodfacts,openproductsfacts,upcitemdb,barcodelookup
# Set in the environment or Django admin > Payment, tax, and lookup integration settings.
BARCODE_LOOKUP_API_KEY=              # secret; obtain this from your Barcode Lookup account


# ---- 6. M-PESA [ADMIN: Payment and tax integration]  (cash sales never need these) -------------------
# sandbox = Safaricom test, live = real money
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=                # secret
MPESA_CONSUMER_SECRET=             # secret
# till = Buy Goods (SHORTCODE = store number, TILL_NUMBER = what customers pay). paybill = SHORTCODE is the paybill.
MPESA_ACCOUNT_TYPE=till
MPESA_SHORTCODE=
MPESA_TILL_NUMBER=
MPESA_PASSKEY=                     # secret
# Public HTTPS address that receives Safaricom's messages, and a long random secret that becomes part of that address.
MPESA_CALLBACK_BASE_URL=
MPESA_CALLBACK_SECRET=             # secret
MPESA_TIMEOUT_SECONDS=12
MPESA_ALLOWED_IPS=                 # optional Safaricom callback IPs/ranges, comma separated
MPESA_TRUST_PROXY=false            # true only behind a trusted Caddy/nginx proxy
# Customer-name lookup (optional, blank = off)
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=         # secret
# Payments the shop PC missed while offline. SAME long token on both machines.
MPESA_RELAY_URL=
MPESA_RELAY_TOKEN=                 # secret


# ---- 7. KRA eTIMS tax invoices [ADMIN: Payment and tax integration] ----------------------------------
# off = receipts are NOT KRA tax invoices, nothing is sent. sandbox = KRA test. live = real invoices.
ETIMS_MODE=off
ETIMS_INTEGRATION=vscu             # vscu = small KRA program on the shop PC; oscu = KRA online
ETIMS_BASE_URL=
ETIMS_BRANCH_ID=00
ETIMS_DEVICE_SERIAL=
ETIMS_COMM_KEY=                    # secret, OSCU only
ETIMS_TIMEOUT_SECONDS=8
ETIMS_QR_URL_TEMPLATE=             # use {tin} {bhf} {sign}; empty = no QR printed


# ---- 8. BACKUPS [ADMIN: Server settings > Backups] ---------------------------------------------------
# Keep the COPY folder on a different disk (USB drive or another PC).
# WINESPOS_BACKUP_DIR=C:\ProgramData\WinesPOS\data\backups
# WINESPOS_BACKUP_COPY_DIR=E:\WinesPOS-Backups
BACKUP_KEEP=30                     # newest backups kept
BACKUP_STALE_HOURS=26              # warn the manager when the newest backup is older than this
# [ENV ONLY] Folder with pg_dump / pg_restore if they are not on PATH (found automatically in Program Files\PostgreSQL)
# WINESPOS_PG_BIN=C:\Program Files\PostgreSQL\16\bin


# ---- 9. SHOP <-> ONLINE SERVER SYNC [ADMIN: Server settings] -----------------------------------------
# Shop PC:
SYNC_ENABLED=false
SYNC_SERVER_URL=
SYNC_TOKEN=                        # secret: the SAME long random text on both machines
SYNC_INTERVAL_MINUTES=30           # between 5 and 1440
SYNC_TIMEOUT_SECONDS=120
SYNC_PULL_MPESA=true               # also fetch missed M-PESA payments each cycle
# Online server only:
SYNC_MAX_UPLOAD_MB=500
# SYNC_INBOX_DIR=/var/lib/winespos/sync_inbox
SYNC_INBOX_KEEP=60
EXTRA_ALLOWED_HOSTS=196.201.214.200,196.201.214.206               # extra host names / IPs the server may answer to
# [ENV ONLY] true when the online server sits behind HTTPS (Caddy / nginx)
ONLINE_SERVER_HTTPS=false

MPESA_ALLOWED_IPS=196.201.214.200,196.201.214.206
MPESA_TRUST_PROXY=True











