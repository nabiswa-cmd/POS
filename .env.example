# Copy to .env and fill in. Never commit .env.

DJANGO_DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL in production). DB_ENGINE=sqlite is for development/tests only:
# it has no row-level locking, so it must never be used for real tills.
DB_ENGINE=postgres
DB_NAME=winespos
DB_USER=winespos
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Security policy
SESSION_IDLE_MINUTES=30
APPROVAL_TOKEN_MINUTES=2
POS_AUTH_MINUTES=5
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=5
MAX_TILLS=2
# Discounts up to this percent of a line need no approval (for staff allowed to give discounts)
ORDINARY_DISCOUNT_MAX_PERCENT=5
USE_ARGON2=false

# Optional fingerprint (Windows Hello) support. Off by default.
# The desktop shell asserts a successful OS biometric check using this shared secret.
BIOMETRIC_ENABLED=false
DESKTOP_SHELL_SECRET=

# Desktop shell
WINESPOS_SERVER_URL=http://127.0.0.1:8000

# Where uploaded product images are stored (default: <project>/media). Keep it inside the shop's backup.
# WINESPOS_MEDIA_ROOT=C:\ProgramData\WinesPOS\media

# --- KRA eTIMS (Kenya electronic tax invoices). Leave ETIMS_MODE=off until your accountant and KRA onboarding are done. ---
# off     = receipts show VAT (if the shop is VAT registered) but are NOT KRA tax invoices; nothing is sent.
# sandbox = send to KRA's test system. live = real invoices.
ETIMS_MODE=off
# vscu = KRA's small program installed on the shop PC (copes with short internet outages); oscu = KRA online.
ETIMS_INTEGRATION=vscu
ETIMS_BASE_URL=
ETIMS_BRANCH_ID=00
ETIMS_DEVICE_SERIAL=
# Only for OSCU. Secret: keep it in .env.
ETIMS_COMM_KEY=
ETIMS_TIMEOUT_SECONDS=8
# Where the receipt QR points; use {tin} {bhf} {sign}. Empty = no QR is printed (nothing is invented).
ETIMS_QR_URL_TEMPLATE=


# --- M-PESA (Phase 4A). Leave blank until you have Daraja credentials; cash sales never need these. ---
# sandbox = Safaricom test system, live = real money.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# till = Buy Goods (SHORTCODE is the store number, TILL_NUMBER is what customers pay). paybill = SHORTCODE is the paybill.
MPESA_ACCOUNT_TYPE=till
MPESA_SHORTCODE=
MPESA_TILL_NUMBER=
MPESA_PASSKEY=
# The public HTTPS address of the server that receives Safaricom's messages (your VPS), and a long random secret
# that becomes part of the callback address. Generate: python -c "import secrets; print(secrets.token_urlsafe(40))"
MPESA_CALLBACK_BASE_URL=
MPESA_CALLBACK_SECRET=
MPESA_TIMEOUT_SECONDS=12
# Relay: payments the shop PC missed while offline. Use the SAME long random MPESA_RELAY_TOKEN on both machines.
# On the shop PC also set MPESA_RELAY_URL (the online server, https://...) and the same MPESA_CALLBACK_SECRET as the server.
MPESA_RELAY_URL=
MPESA_RELAY_TOKEN=


# --- Phase 6: installed shop (the installer writes these for you into C:\ProgramData\WinesPOS\config\winespos.env) ---
# Server: 127.0.0.1 = this PC only. 0.0.0.0 = the shop network too (needed for a second till). Add the server's address to DJANGO_ALLOWED_HOSTS.
WINESPOS_BIND=127.0.0.1
WINESPOS_PORT=8000
# Backups (docs/BACKUP_AND_RESTORE.md). Put the COPY folder on a different disk: a USB drive or another PC's shared folder.
# WINESPOS_BACKUP_DIR=C:\ProgramData\WinesPOS\data\backups
# WINESPOS_BACKUP_COPY_DIR=E:\WinesPOS-Backups
BACKUP_KEEP=30
BACKUP_STALE_HOURS=26
# Folder holding pg_dump / pg_restore if they are not on the PATH (found automatically in C:\Program Files\PostgreSQL\*\bin).
# WINESPOS_PG_BIN=C:\Program Files\PostgreSQL\16\bin
# Receipt printer, exact Windows name (list with: WinesPOS.exe printers). Empty = the normal Windows print dialog.
# On each till PC. Silent printing is untested on real hardware.
# WINESPOS_RECEIPT_PRINTER=EPSON TM-T20III Receipt
