{% load static %}
{
  "id": "/app/pos/",
  "name": "Wines & Spirits POS",
  "short_name": "Wine POS",
  "description": "Shop cashier and till application",
  "start_url": "/app/pos/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#321516",
  "theme_color": "#321516",
  "orientation": "any",
  "icons": [
    {
      "src": "{% static 'core/icons/icon-192.png' %}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{% static 'core/icons/icon-512.png' %}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
